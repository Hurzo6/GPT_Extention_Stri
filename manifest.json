{
  "manifest_version": 3,
  "name": "GPT Notification/Quiz - STRI",
  "version": "1.03",
  "description": "Extension permettant de gérer les interactions avec ChatGPT sur des pages web.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "commands"
  ],
  "options_page": "Options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "send_to_chatgpt": {
      "suggested_key": {
        "mac": "Command+Shift+1",
        "default": "Ctrl+I"
      },
      "description": "Envoyer la sélection à ChatGPT"
    },
    "toggle_notifications": {
      "suggested_key": {
        "mac": "Command+Shift+N",
        "default": "Ctrl+Shift+N"
      },
      "description": "Activer/Désactiver les notifications"
    }
  }
}
